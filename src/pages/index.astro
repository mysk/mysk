---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { getCollection } from "astro:content";

const work = (await getCollection("work"))
	.filter((entry) => !entry.data.draft)
	.sort(
		(a, b) =>
			(b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
	);

const projects = (await getCollection("projects"))
	.filter((entry) => !entry.data.draft)
	.sort(
		(a, b) =>
			(b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
	);

const externalProjects = [
	{
		title: "Adventurers' Record Keeper",
		description: "Tools and resources for Final Fantasy XI players",
		href: "https://ffxiark.com",
	},
];

const posts = (await getCollection("writing"))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
	title="Julian Dawson — Mysk"
	description="Engineer and founder. Co-Founder and Head of Engineering at Forsyte. Based in Bristol."
>
	<Hero />

	{
		work.length > 0 && (
			<Section id="work" label="Work">
				<ul class="list">
					{work.map((entry) => (
						<li>
							<a href={`/work/${entry.id}/`}>{entry.data.title}</a>
						</li>
					))}
				</ul>
			</Section>
		)
	}

	{
		projects.length > 0 && (
			<Section id="projects" label="Projects">
				<ul class="list">
					{projects.map((entry) => (
						<li class="entry">
							<a href={`/projects/${entry.id}/`}>{entry.data.title}</a>
							<span class="entry-desc">{entry.data.description}</span>
						</li>
					))}
					{externalProjects.map((entry) => (
						<li class="entry">
							<a href={entry.href} target="_blank" rel="noreferrer">
								<span class="link-text">{entry.title}</span>
								<svg
									class="ext"
									viewBox="6 6 12 12"
									fill="none"
									aria-hidden="true"
								>
									<path
										stroke="currentColor"
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="1.8"
										d="M17.25 15.25V6.75H8.75"
									></path>
									<path
										stroke="currentColor"
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="1.8"
										d="M17 7L6.75 17.25"
									></path>
								</svg>
							</a>
							<span class="entry-desc">{entry.description}</span>
						</li>
					))}
				</ul>
			</Section>
		)
	}

	{
		posts.length > 0 && (
			<Section id="writing" label="Writing">
				<ul class="list">
					{posts.map((entry) => (
						<li>
							<a href={`/writing/${entry.id}/`}>{entry.data.title}</a>
						</li>
					))}
				</ul>
			</Section>
		)
	}
</Layout>
