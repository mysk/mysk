---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatBlogDate } from "../../lib/utils";

export async function getStaticPaths() {
	const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — MYSK`} description={post.data.description}>
	<article class="mx-auto max-w-[42rem] px-[var(--spacing-gutter)] pb-20 pt-10">
		<a
			href="/#writing"
			class="mb-10 inline-flex items-center gap-2 font-mono text-mono-label uppercase tracking-[0.1em] text-fg-muted transition-opacity hover:opacity-55"
		>
			← Back
		</a>

		<header class="border-b border-line pb-6">
			<div
				class="mb-4 flex flex-wrap items-center gap-3 font-mono text-mono-data uppercase tracking-[0.1em] text-fg-muted"
			>
				<time datetime={post.data.date.toISOString()}>
					{formatBlogDate(post.data.date)}
				</time>
				{
					post.data.tags.length > 0 && (
						<span>{post.data.tags.join(" · ")}</span>
					)
				}
			</div>
			<h1
				class="m-0 text-[clamp(2rem,5vw,3.25rem)] font-medium leading-[0.95] tracking-[-0.045em]"
			>
				{post.data.title}
			</h1>
			<p class="mt-4 text-lg leading-snug text-fg-muted">
				{post.data.description}
			</p>
		</header>

		<div class="prose-editorial mt-8">
			<Content />
		</div>
	</article>
</Layout>
