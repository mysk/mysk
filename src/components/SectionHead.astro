---
interface Props {
	num: string;
	title: string;
	tag?: string;
}

const { num, title, tag } = Astro.props;
---

<div
	class="grid grid-cols-[60px_1fr] items-end gap-4 px-[var(--spacing-gutter)] pb-7 pt-[60px] md:grid-cols-[110px_1fr_auto]"
>
	<div class="font-mono text-[11px] uppercase tracking-[0.12em]">{num}</div>
	<h2
		class="m-0 text-[length:var(--text-section)] font-medium leading-[0.9] tracking-[-0.055em]"
	>
		{title}
	</h2>
	{
		tag && (
			<div class="hidden font-mono text-[11px] uppercase tracking-[0.12em] md:block">
				{tag}
			</div>
		)
	}
</div>
