---
import { getCollection } from "astro:content";

interface Props {
	breadcrumb?: { label: string; href: string };
}

const { breadcrumb } = Astro.props;

const socials = (await getCollection("links")).sort(
	(a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
---

<header class="section site-header">
	<p class="flex items-baseline gap-2">
		<a href="/" class="font-medium tracking-tight">Mysk</a>
		{
			breadcrumb && (
				<>
					<span class="text-fg-dim" aria-hidden="true">
						/
					</span>
					<a href={breadcrumb.href} class="link">
						{breadcrumb.label}
					</a>
				</>
			)
		}
	</p>

	<ul
		class="list md:col-start-3 md:items-end"
		aria-label="Elsewhere"
	>
		{
			socials.map((link) => (
				<li>
					<a
						href={link.data.url}
						class="link"
						target="_blank"
						rel="noreferrer"
					>
						{link.data.title}
					</a>
				</li>
			))
		}
		<li>
			<a href="/julian-dawson-cv.pdf" class="link">CV (PDF 248kb)</a>
		</li>
	</ul>
</header>
