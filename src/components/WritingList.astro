---
import type { CollectionEntry } from "astro:content";
import { formatBlogDate } from "../lib/utils";

interface Props {
	posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<div class="border-t border-line">
	{
		posts.map((post) => (
			<a class="writing-row" href={`/blog/${post.id}/`}>
				<time
					datetime={post.data.date.toISOString()}
					class="font-mono text-[11px] uppercase tracking-[0.11em]"
				>
					{formatBlogDate(post.data.date)}
				</time>
				<span class="project-name text-[clamp(22px,4vw,40px)]">
					{post.data.title}
				</span>
				<span class="font-mono text-[11px] uppercase tracking-[0.11em] max-md:hidden">
					{post.data.tags.join(" · ")}
				</span>
			</a>
		))
	}
</div>
