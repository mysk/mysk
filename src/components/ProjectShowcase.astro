---
import type { CollectionEntry } from "astro:content";
import { getProjectUrl } from "../lib/utils";

interface Props {
	projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

const tintClass: Record<CollectionEntry<"projects">["data"]["tint"], string> = {
	periwinkle: "bg-tint-periwinkle",
	sage: "bg-tint-sage",
	peach: "bg-tint-peach",
	butter: "bg-tint-butter",
	lilac: "bg-tint-lilac",
};

function padIndex(index: number): string {
	return String(index + 1).padStart(2, "0");
}

function yearOf(date: Date): string {
	return String(date.getFullYear());
}

const entries = projects.map((project) => ({
	project,
	href: getProjectUrl(project),
}));
---

{
	entries.length > 0 ? (
		<div class="project-showcase" data-project-showcase>
			<nav class="project-nav" aria-label="Selected projects">
				{entries.map(({ project, href }, index) =>
					href ? (
						<a
							class:list={["project-link", { active: index === 0 }]}
							href={href}
							target="_blank"
							rel="noreferrer"
							data-project={index}
						>
							<span class="project-link-index">{padIndex(index)}</span>
							<span class="project-link-name">{project.data.title}</span>
							<span class="project-link-meta">
								{project.data.discipline} · {yearOf(project.data.date)}
							</span>
						</a>
					) : (
						<button
							class:list={["project-link", { active: index === 0 }]}
							type="button"
							data-project={index}
						>
							<span class="project-link-index">{padIndex(index)}</span>
							<span class="project-link-name">{project.data.title}</span>
							<span class="project-link-meta">
								{project.data.discipline} · {yearOf(project.data.date)}
							</span>
						</button>
					)
				)}
			</nav>

			<div class="project-panels" aria-live="polite">
				{entries.map(({ project, href }, index) => (
					<article
						class:list={["project-panel", { active: index === 0 }]}
						data-preview={index}
					>
						<div class:list={["preview-visual", tintClass[project.data.tint]]}>
							<div class="lettermark">{project.data.lettermark}</div>
						</div>
						<div class="preview-copy">
							<div>
								<p class="preview-kicker">
									{padIndex(index)} / {project.data.title}
								</p>
								<p class="preview-summary">{project.data.summary}</p>
								{href && (
									<a
										class="preview-visit"
										href={href}
										target="_blank"
										rel="noreferrer"
									>
										Visit project <span aria-hidden="true">↗</span>
									</a>
								)}
							</div>
							<div class="preview-facts">
								{project.data.facts.map((fact) => (
									<div class="fact">
										<span>{fact.label}</span>
										<span>{fact.value}</span>
									</div>
								))}
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	) : (
		<p class="border-t border-line px-[var(--spacing-gutter)] py-10 text-fg-muted">
			No projects yet.
		</p>
	)
}

<script>
	const root = document.querySelector<HTMLElement>("[data-project-showcase]");
	if (root) {
		const links = [...root.querySelectorAll<HTMLElement>("[data-project]")];
		const panels = [...root.querySelectorAll<HTMLElement>("[data-preview]")];

		function activate(index: number) {
			links.forEach((link, i) => link.classList.toggle("active", i === index));
			panels.forEach((panel, i) => panel.classList.toggle("active", i === index));
		}

		links.forEach((link) => {
			const index = Number(link.dataset.project);
			link.addEventListener("mouseenter", () => activate(index));
			link.addEventListener("focus", () => activate(index));
		});
	}
</script>
