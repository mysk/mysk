---
import { getCollection } from "astro:content";

const year = new Date().getFullYear();

const links = (await getCollection("links")).sort(
	(a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);
---

<footer class="section site-footer border-t border-line">
	<p class="label">© {year} Julian Dawson</p>
	<ul class="list" aria-label="Elsewhere">
		{
			links.map((link) => (
				<li>
					<a href={link.data.url} target="_blank" rel="noreferrer">
						{link.data.title}
					</a>
				</li>
			))
		}
		<li>
			<a href="mailto:hello@mysk.dev">Email</a>
		</li>
	</ul>
</footer>
